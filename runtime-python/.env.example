RUNTIME_PORT=9572
INTERNAL_TOKEN=change-me-runtime-internal-token
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_VISION_NAME=qwen-vl-plus
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
HTTP_AGENT_TIMEOUT_SECONDS=8
MODEL_HTTP_TRUST_ENV=true
MAX_RESCHEDULE_ATTEMPTS=2

# Adaptive Workflow Orchestration
SEMANTIC_PLANNER_ENABLED=true
SEMANTIC_PLANNER_TIMEOUT_SECONDS=12
SEMANTIC_PLANNER_MAX_STEPS=8
MAX_REPLAN_ATTEMPTS=1
QUALITY_GATE_ENABLED=true
QUALITY_GATE_PASS_THRESHOLD=0.58
QUALITY_GATE_HARD_FAIL_THRESHOLD=0.20
MAX_QUALITY_REPAIR_ATTEMPTS=1
LANGGRAPH_QUALITY_THRESHOLD=0.58
LANGGRAPH_MAX_REPAIRS=1
TOOL_TIMEOUT_SECONDS=8
MAX_TOOL_ITERATIONS=5
TOOL_MAX_RETRIES=1
TOOL_RETRY_BACKOFF_SECONDS=0.1
MCP_DEMO_HOST=127.0.0.1
MCP_DEMO_PORT=9583

# Evaluation Eval / Cost Telemetry
# Set provider-specific prices when known. Leave 0 to show model cost as unconfigured.
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
EXECUTION_ROUTING_SEMANTIC_MODEL_TIMEOUT_SECONDS=6.0
EVAL_SCORECARD_ENABLED=true

# Adaptive Routing Adaptive Routing
# Adaptive Model routing activates when Scheduler=adaptive. With only the
# default runtime the behaviour is unchanged. Optional candidate example:
# MODEL_RUNTIME_POOL_JSON=[{"runtimeId":"fast","provider":"mock","model":"mock-fast","qualityScore":0.76,"avgLatencyMs":300,"avgCost":0.001,"successRate":0.99}]
MODEL_ROUTER_ENABLED=true
MODEL_RUNTIME_POOL_JSON=[]
MODEL_ROUTING_DEFAULT_QUALITY=0.82
MODEL_ROUTING_DEFAULT_LATENCY_MS=1200
MODEL_ROUTING_DEFAULT_AVG_COST=0
MODEL_ROUTING_DEFAULT_SUCCESS_RATE=1.0

# Durable Runtime Distributed Runtime Worker
RUNTIME_WORKER_ENABLED=true
RUNTIME_WORKER_ID=runtime-local-1
RUNTIME_WORKER_ENDPOINT=http://127.0.0.1:9572
CONTROL_PLANE_INTERNAL_BASE_URL=http://127.0.0.1:8086
RUNTIME_WORKER_CAPACITY=4
RUNTIME_NODE_ID=runtime-local-node-1
RUNTIME_NODE_ZONE=local
RUNTIME_NODE_VERSION=3.0.0-dev
RUNTIME_NODE_CAPACITY=4
RUNTIME_WORKER_HEARTBEAT_SECONDS=5
RUNTIME_WORKER_CALLBACK_TIMEOUT_SECONDS=5
RUNTIME_WORKER_CALLBACK_MAX_RETRIES=5
RUNTIME_WORKER_SHUTDOWN_GRACE_SECONDS=20
RUNTIME_WORKER_DEDUPE_RETENTION_SECONDS=3600

# Event Delivery Runtime Result Event Plane
# http = legacy callback compatibility; kafka = durable local outbox + Kafka.
RUNTIME_RESULT_TRANSPORT=http
KAFKA_BROKERS=127.0.0.1:29092
KAFKA_RUNTIME_RESULT_TOPIC=agentmesh.runtime.events
KAFKA_CLIENT_ID=agentmesh-runtime-python
KAFKA_OUTBOX_PATH=./data/runtime_result_outbox.sqlite3
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
