# Desktop Bridge binds to loopback only.
DESKTOP_BRIDGE_HOST=127.0.0.1
DESKTOP_BRIDGE_PORT=9583
DESKTOP_BRIDGE_TOKEN=replace-with-a-long-random-token

# Default product mode: ordinary local fixed-drive files are available through the
# current Windows user's permissions. Sensitive/application-private/system paths
# stay protected; mutating tools still require Runtime approval.
DESKTOP_ACCESS_MODE=local

# Optional enterprise/sandbox mode. Set DESKTOP_ACCESS_MODE=restricted and provide
# explicit roots. This preserves the original allowlist behavior.
DESKTOP_ALLOWED_ROOTS_JSON=[]

DESKTOP_AUDIT_FILE=./data/desktop-audit.jsonl
DESKTOP_MAX_READ_BYTES=1048576
DESKTOP_MAX_WRITE_BYTES=2097152
DESKTOP_MAX_SEARCH_FILES=2000
DESKTOP_MAX_SEARCH_RESULTS=100

# Known applications and CLI tools are discovered from PATH / Windows App Paths.
DESKTOP_AUTO_DISCOVER_EXECUTABLES=true
DESKTOP_ALLOWED_APPS_JSON=[]
DESKTOP_ALLOWED_TOOLS_JSON=[]

# Advanced terminal remains opt-in and always high risk.
DESKTOP_ALLOW_TERMINAL=false

# GUI computer use remains opt-in and begins only after an approved session.start.
DESKTOP_COMPUTER_USE_ENABLED=false
DESKTOP_COMPUTER_SESSION_TTL_SECONDS=1800
DESKTOP_SCREENSHOT_MAX_WIDTH=1920
DESKTOP_SCREENSHOT_MAX_BYTES=5242880

DESKTOP_PROCESS_OUTPUT_MAX_BYTES=262144
DESKTOP_PROCESS_INITIAL_WAIT_SECONDS=30
