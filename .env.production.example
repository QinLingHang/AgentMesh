# AgentMesh P10 production environment.
# Copy to .env.production, replace every CHANGE_ME value, and never commit it.

# Compose isolation / persistent volume namespace
AGENTMESH_COMPOSE_PROJECT=agentmesh-production
DATA_VOLUME_PREFIX=agentmesh-prod

# Public gateway
PUBLIC_ORIGIN=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443
REQUIRE_TLS=false
# Directory containing fullchain.pem and privkey.pem when REQUIRE_TLS=true.
TLS_CERT_DIR=./infra/gateway/tls
AUTH_COOKIE_SECURE=false

# MySQL
MYSQL_DATABASE=agentmesh_mvp
MYSQL_USER=agentmesh
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# Milvus object storage
MINIO_ACCESS_KEY=agentmesh-minio
MINIO_SECRET_KEY=CHANGE_ME_minio_secret

# Control-plane secrets
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters
VERIFICATION_PEPPER=CHANGE_ME_verification_pepper_at_least_16_characters
RUNTIME_INTERNAL_TOKEN=CHANGE_ME_runtime_internal_token_at_least_16_characters
GOVERNANCE_MASTER_KEY=CHANGE_ME_governance_master_key_at_least_32_characters

# Registration email. Keep console only for local deployment validation.
EMAIL_PROVIDER=
EMAIL_ADDRESS=
EMAIL_AUTH_CODE=
EMAIL_APP_NAME=AgentMesh

# Default model runtime. Project BYOK remains request-local and project-scoped.
MODEL_PROVIDER=mock
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_VISION_NAME=qwen-vl-plus

# Runtime capacity / queue
RUNTIME_WORKER_ID=runtime-compose-1
RUNTIME_WORKER_CAPACITY=4
RUNTIME_NODE_ID=runtime-node-a
RUNTIME_NODE_ZONE=zone-a
RUNTIME_NODE_CAPACITY=4
DURABLE_RUNTIME_DISPATCHER_ID=dispatcher-a
DURABLE_RUNTIME_DISPATCHER_LEASE_SECONDS=5
DURABLE_RUNTIME_EXECUTION_LEASE_SECONDS=20
DURABLE_RUNTIME_MAX_QUEUE_DEPTH=500
