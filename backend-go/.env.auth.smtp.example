# Copy these values into backend-go/.env.
# Never commit the real authorization code or pepper.

# Choose one: qq / 163 / 126
EMAIL_PROVIDER=qq

# Sender mailbox.
EMAIL_ADDRESS=<your-sender@qq.com>

# SMTP/client authorization code.
# This is NOT the normal mailbox login password.
EMAIL_AUTH_CODE=<your-smtp-authorization-code>

EMAIL_APP_NAME=AgentMesh

# Generate a random value locally.
VERIFICATION_PEPPER=<random-secret-at-least-16-characters>

# Optional verification policy.
VERIFICATION_CODE_TTL_MINUTES=5
VERIFICATION_COOLDOWN_SECONDS=60
VERIFICATION_SEND_WINDOW_MINUTES=60
VERIFICATION_MAX_SENDS_PER_WINDOW=10
VERIFICATION_MAX_VERIFY_ATTEMPTS=5
VERIFICATION_SEND_RECORD_SECONDS=60
