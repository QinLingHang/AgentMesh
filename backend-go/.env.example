BUSINESS_PORT=8086
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_DATABASE=agentmesh_mvp
MYSQL_USER=agentmesh
MYSQL_PASSWORD=agentmesh123
REDIS_ADDR=127.0.0.1:6382
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
JWT_ISSUER=agentmesh-control-plane
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
RUNTIME_BASE_URL=http://127.0.0.1:9572
RUNTIME_INTERNAL_TOKEN=change-me-runtime-internal-token
RUNTIME_TIMEOUT_SECONDS=30
MCP_DEMO_ENDPOINT=http://127.0.0.1:9583/mcp
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TASK_RATE_LIMIT_PER_MINUTE=30

# P8 Distributed Runtime / Durable Queue
DURABLE_RUNTIME_ENABLED=true
CONTROL_PLANE_INTERNAL_BASE_URL=http://127.0.0.1:8086
DURABLE_RUNTIME_POLL_MS=300
DURABLE_RUNTIME_LEASE_SECONDS=15
DURABLE_RUNTIME_WORKER_STALE_SECONDS=20
DURABLE_RUNTIME_ACCEPTANCE_TIMEOUT_SECONDS=5
DURABLE_RUNTIME_RETRY_BACKOFF_MS=500
DURABLE_RUNTIME_JOB_DEADLINE_SECONDS=120
DURABLE_RUNTIME_MAX_ATTEMPTS=3
DURABLE_RUNTIME_MAX_QUEUE_DEPTH=500
DURABLE_RUNTIME_CIRCUIT_FAILURE_THRESHOLD=3
DURABLE_RUNTIME_CIRCUIT_OPEN_SECONDS=20

# P9 Enterprise Governance
# Use a dedicated high-entropy value in production. If omitted, local development falls back to JWT_SECRET.
GOVERNANCE_MASTER_KEY=replace-with-at-least-32-random-characters
